PORT=3001
NODE_ENV=development

# CORS: Orígenes permitidos, separados por coma. Soporta patrones con * (ej. https://*.vercel.app).
# Producción ejemplo: https://colorados-drive-platform.vercel.app,https://*.vercel.app
CORS_ORIGIN=http://localhost:3000

# Supabase — SOLO base de datos (la identidad vive en Keycloak)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Keycloak — control de identidades central (OIDC directo)
KEYCLOAK_URL=https://keycloak-production-43dc.up.railway.app
KEYCLOAK_REALM=udla8
KEYCLOAK_AUDIENCE=colorados-api
KEYCLOAK_SERVICE_CLIENT_ID=colorados-service
KEYCLOAK_SERVICE_CLIENT_SECRET=your-service-client-secret

# Vault Transit (KMS) — cifrado de la trama A→B (token con permiso SOLO de encrypt)
VAULT_ADDR=http://vault.railway.internal:8200
VAULT_TOKEN=your-vault-token-a
VAULT_TRANSIT_KEY=certifications-key

# Sistema B (CampusRide) — receptor de certificaciones cifradas
CAMPUSRIDE_API_URL=http://localhost:3006
