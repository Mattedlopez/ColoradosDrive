{
  "name": "colorados-drive-api",
  "version": "1.0.0",
  "description": "Backend API for Colorados Drive driving school platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node ./node_modules/typescript/bin/tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:print-010": "node -e \"const fs=require('fs');const path=require('path');const sql=fs.readFileSync(path.join(__dirname,'src/db/migrations/010_course_price_and_payments.sql'),'utf8');console.log('Ejecuta este SQL en Supabase > SQL Editor:\\n');console.log(sql);\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "driving-school",
    "api",
    "education"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.110.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.5",
    "@types/uuid": "^9.0.7",
    "archiver": "^7.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jose": "^4.15.9",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.17.2",
    "typescript": "^5.3.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/jest": "^29.5.12",
    "@types/pdfkit": "^0.17.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "tsx": "^4.7.0"
  }
}
